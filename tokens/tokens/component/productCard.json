{
  "productCard": {
    "brandBadge": {
      "container": {
        "height": {
          "$value": "{sizing.height.xxxs}",
          "$type": "size"
        }
      }
    },
    "container": {
      "gap-y": {
        "$value": "{spacing.gap-y.sm}",
        "$type": "space"
      }
    },
    "counts": {
      "gap-x": {
        "$value": "{spacing.gap-x.xs}",
        "$type": "space"
      }
    },
    "date": {
      "label": {
        "color": {
          "$value": "{color.fg.neutral.weak}",
          "$type": "color"
        },
        "typography": {
          "$value": "{typography.caption.xs}",
          "$type": "typography"
        }
      }
    },
    "discountRate": {
      "label": {
        "color": {
          "$value": "{color.fg.brand.contrast.default}",
          "$type": "color"
        },
        "typography": {
          "threeColumn": {
            "$value": "{typography.label.bold.xxs}",
            "$type": "typography"
          },
          "twoColumn": {
            "$value": "{typography.label.bold.lg}",
            "$type": "typography"
          }
        }
      }
    },
    "favoriteToggle": {
      "container": {
        "size": {
          "$value": "{sizing.height.xl}",
          "$type": "size"
        }
      },
      "icon": {
        "asset": {
          "off": {
            "$value": "{icon.toggle.favoriteOverlay.off}",
            "$type": "asset",
            "$extensions": {
              "com.figma": {
                "scopes": [],
                "codeSyntax": {},
                "hiddenFromPublishing": false
              }
            }
          },
          "on": {
            "$value": "{icon.toggle.favorite.on}",
            "$type": "asset",
            "$extensions": {
              "com.figma": {
                "scopes": [],
                "codeSyntax": {},
                "hiddenFromPublishing": false
              }
            }
          }
        },
        "color": {
          "off": {
            "$value": "{color.fg.neutral.onSolid.default}",
            "$type": "color",
            "$extensions": {
              "com.figma": {
                "scopes": [],
                "codeSyntax": {},
                "hiddenFromPublishing": false
              }
            }
          },
          "on": {
            "$value": "{color.fg.brand.contrast.default}",
            "$type": "color",
            "$extensions": {
              "com.figma": {
                "scopes": [],
                "codeSyntax": {},
                "hiddenFromPublishing": false
              }
            }
          }
        }
      }
    },
    "info": {
      "container": {
        "gap-y": {
          "threeColumn": {
            "$value": "{spacing.gap-y.xxs}",
            "$type": "space"
          },
          "twoColumn": {
            "$value": "{spacing.gap-y.xs}",
            "$type": "space"
          }
        }
      }
    },
    "itemName": {
      "label": {
        "typography": {
          "threeColumn": {
            "$value": "{typography.body6}",
            "$type": "typography"
          },
          "twoColumn": {
            "$value": "{typography.body4}",
            "$type": "typography"
          }
        }
      }
    },
    "price": {
      "label": {
        "color": {
          "$value": "{color.fg.neutral.default}",
          "$type": "color"
        },
        "typography": {
          "threeColumn": {
            "$value": "{typography.label.bold.md}",
            "$type": "typography"
          },
          "twoColumn": {
            "$value": "{typography.label.bold.lg}",
            "$type": "typography"
          }
        }
      }
    },
    "priceInfo": {
      "container": {
        "gap-y": {
          "$value": "{spacing.gap-y.xxs}",
          "$type": "space"
        }
      }
    },
    "subInfo": {
      "container": {
        "gap-x": {
          "$value": "{spacing.gap-x.xs}",
          "$type": "space",
          "$extensions": {
            "com.figma": {
              "scopes": [],
              "codeSyntax": {},
              "hiddenFromPublishing": false
            }
          }
        }
      }
    },
    "thumbnail": {
      "container": {
        "radius": {
          "$value": "{radius.sm}",
          "$type": "borderRadius",
          "$extensions": {
            "com.figma": {
              "scopes": [
                "ALL_SCOPES"
              ],
              "codeSyntax": {},
              "hiddenFromPublishing": false
            }
          }
        }
      }
    },
    "title": {
      "label": {
        "color": {
          "$value": "{color.fg.neutral.muted}",
          "$type": "color"
        }
      }
    },
    "todayDealBadge": {
      "container": {
        "height": {
          "$value": "{sizing.height.xxxxs}",
          "$type": "size"
        }
      }
    }
  }
}