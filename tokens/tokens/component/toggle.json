{
  "toggle": {
    "icon": {
      "asset": {
        "favorite": {
          "off": {
            "$value": "{asset.icon.state.favorite.off}",
            "$type": "asset"
          },
          "on": {
            "$value": "{asset.icon.state.favorite.on}",
            "$type": "asset"
          }
        }
      },
      "color": {
        "bookmark": {
          "off": {
            "$value": "{color.fg.neutral.subtlest}",
            "$type": "color"
          },
          "on": {
            "$value": "{color.fg.brand.contrast.enabled}",
            "$type": "color"
          }
        },
        "bookmarkOutlined": {
          "off": {
            "$value": "{color.fg.neutral.onSolid.enabled}",
            "$type": "color"
          }
        },
        "check": {
          "on": {
            "$value": "{color.fg.neutral.default}",
            "$type": "color"
          }
        },
        "noti": {
          "off": {
            "$value": "{color.fg.neutral.subtlest}",
            "$type": "color"
          },
          "on": {
            "$value": "{color.fg.neutral.default}",
            "$type": "color"
          }
        }
      },
      "size": {
        "size-lg": {
          "$value": "{sizing.icon.sm}",
          "$type": "size"
        },
        "size-md": {
          "$value": "{sizing.icon.xs}",
          "$type": "size"
        },
        "size-sm": {
          "$value": "{sizing.icon.xxs}",
          "$type": "size"
        },
        "size-xl": {
          "$value": "{sizing.icon.md}",
          "$type": "size"
        }
      }
    }
  }
}